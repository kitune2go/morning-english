{
  "id": "card-226",
  "title": "No.226 三人分を一人で分担",
  "scenes": [
    {
      "id": "226-open",
      "when": { "trigger": "cardOpen" },
      "steps": [
        { "enter": "pink", "at": "textRight" },
        { "who": "pink", "say": "きょうだいでdivideしましょう。まず私が増えます" },
        { "swarm": "pink", "count": 5, "every": 0.14, "at": "screen", "say": ["分担！", "交代！", "今日は誰？"] },
        { "who": "pink", "say": "分身できる教材キャラを家族モデルに使わないでください" }
      ]
    },
    {
      "id": "226-long-care",
      "when": { "trigger": "idle", "after": 13 },
      "steps": [
        { "enter": "cat", "at": "offLeft" },
        { "who": "cat", "move": "overText", "sec": 1.3 },
        { "who": "cat", "act": "sleep" },
        { "who": "pink", "say": "猫は長期担当を寝て表現しています" },
        { "who": "pink2", "say": "人数、期間、相続条件を一つずつ確認。根性論は禁止" },
        { "who": "pink", "act": "shake" }
      ]
    },
    {
      "id": "226-bye",
      "when": { "trigger": "dismiss", "reason": "button" },
      "steps": [
        { "who": "any", "say": "撤収作業は全員でdivideします" },
        { "wait": 1 },
        { "exit": "all" }
      ]
    }
  ]
}
